# Non-secret local CLI configuration only. Never put real secrets in this file.
AWS_REGION=eu-central-1
AWS_PROFILE=
SNOOZEFINE_ENVIRONMENT=SANDBOX
AMPLIFY_OUTPUTS_PATH=./amplify_outputs.json

# Set the webhook secret with:
# npx ampx sandbox secret set REVENUECAT_WEBHOOK_AUTH_TOKEN
# Optional future RevenueCat API lookups:
# npx ampx sandbox secret set REVENUECAT_SECRET_API_KEY
